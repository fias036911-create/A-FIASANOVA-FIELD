import numpy as np
from scipy.signal import hilbert

def compute_plv(phase1, phase2=None, window_samples=128):
    """Compute Phase Locking Value within or between signals."""
    if phase2 is None:
        # Within-brain: phase1 is array of channels
        complex_phase = np.exp(1j * phase1)
        plv = np.abs(np.mean(complex_phase, axis=0))
    else:
        # Between-brain: phase1 and phase2 are single time series
        phase_diff = phase1 - phase2
        complex_diff = np.exp(1j * phase_diff)
        # Apply sliding window
        plv = np.abs(np.convolve(complex_diff, np.ones(window_samples)/window_samples, mode='same'))
    return plv

def compute_balanced_te(phase1, phase2, delay=1):
    """Simplified Transfer Entropy proxy for synthetic data."""
    # For real data, use a proper TE library like JIDT
    # This is a placeholder correlation-based proxy
    corr = np.corrcoef(phase1[delay:], phase2[:-delay])[0,1]
    # Make it balanced and normalized [0,1]
    balance = 1 - np.abs(corr)  # Simple proxy for bidirectionality
    strength = (corr + 1) / 2  # Normalize to [0,1]
    return strength * balance

def calculate_acho(human_phase, ai_phase, lambdas=(0.4, 0.4, 0.2)):
    """
    Main function: Compute the ACHO resonance index.
    
    Parameters:
    human_phase, ai_phase: Phase time series [-π, π]
    lambdas: Weights for (within, between, transfer) terms
    
    Returns:
    R_acho: The composite resonance index over time
    """
    # 1. Within-brain coherence (simplified: single channel)
    R_in = compute_plv(np.array([human_phase]))  # Would be multi-channel in reality
    
    # 2. Between-brain PLV
    PLV_ha = compute_plv(human_phase, ai_phase)
    
    # 3. Balanced Transfer Entropy
    R_te = compute_balanced_te(human_phase, ai_phase)
    
    # 4. Combine with weights
    R_acho = lambdas[0]*R_in + lambdas[1]*PLV_ha + lambdas[2]*R_te
    
    return R_acho, {'R_in': R_in, 'PLV_ha': PLV_ha, 'R_te': R_te}
